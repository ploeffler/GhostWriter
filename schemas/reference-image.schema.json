{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ploeffler/GhostWriter/schemas/reference-image.schema.json",
  "title": "Projektweite visuelle Referenz",
  "type": "object",
  "required": ["id", "file", "caption", "description", "roles", "status", "origin", "links", "created_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^ref-img-[a-z0-9][a-z0-9-]*$"},
    "file": {"type": "string", "pattern": "^ref-img-[a-z0-9][a-z0-9-]*\\.(png|jpg)$"},
    "caption": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "purpose": {"type": "string"},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["book_image", "visual_reference"]}},
    "status": {"enum": ["stored", "approved", "withdrawn"]},
    "origin": {"enum": ["own", "provided", "licensed", "generated", "unknown"]},
    "license": {"type": "string"},
    "consent": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "links": {"type": "array", "items": {"type": "object", "required": ["kind", "id"], "properties": {
      "kind": {"enum": ["project", "person", "place", "object", "scene", "chapter", "section"]},
      "id": {"type": "string", "minLength": 1}
    }, "additionalProperties": false}},
    "width_px": {"type": "integer", "minimum": 1},
    "height_px": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
