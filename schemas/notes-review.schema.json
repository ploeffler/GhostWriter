{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ploeffler/GhostWriter/schemas/notes-review.schema.json",
  "title": "Hinweisdurchsicht (editorial/durchsicht-<datum>.yml, #367): gesammelte offene Befunde mit Entscheidungen",
  "type": "object",
  "required": ["buch", "erstellt", "quelle", "anleitung", "ohne_autor", "autorenentscheidung"],
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "befund", "abschnitt", "section_id", "chapter_id", "datei", "art", "grund", "alt", "neu", "entscheidung"],
      "properties": {
        "id": {"type": "string", "pattern": "^e-[0-9]{3,}$"},
        "befund": {"type": "string", "description": "Quelle: <befunddatei>#<befund-id>"},
        "abschnitt": {"type": "string", "minLength": 1, "description": "Kapitel.Abschnitt (1.2), Titel eines Teils von Vor-/Nachspann oder „Buch“ (#423)"},
        "section_id": {"type": "string"},
        "chapter_id": {"type": "string"},
        "chapter_status": {"type": "string"},
        "datei": {"type": "string"},
        "absatz": {"type": "integer", "minimum": 1},
        "art": {"type": "string"},
        "grund": {"type": "string"},
        "kontext": {"type": "string"},
        "alt": {"type": "string"},
        "neu": {"type": "string"},
        "frage": {"type": "string"}, "schweregrad": {"enum": ["gering", "mittel", "wesentlich", "blockierend"]}, "varianten": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 3}, "variante": {"type": "integer", "minimum": 1, "description": "gewählte Variante (1-basiert), #473"}, "streichen": {"type": "boolean", "description": "der alte Wortlaut entfällt; `neu` bleibt leer (#615)"}, "vorschlag_von": {"enum": ["assistent"], "description": "`neu` (und `varianten`) stammen vom Assistenten (hinweise.py propose, #609)"}, "neu_befund": {"type": "string", "description": "ursprünglicher Vorschlag aus der Befunddatei, wenn der Assistent `neu` ersetzt hat"}, "thema": {"type": "string"}, "muster": {"type": "string"},
        "entscheidung": {"enum": ["offen", "ja", "nein", "geändert"]},
        "umgesetzt": {"type": "boolean", "description": "ins Manuskript übernommen (hinweise.py apply)"},
        "begruendung": {"type": "string", "description": "Begründung des Autors zu seiner Entscheidung, z. B. warum eine Stelle bleibt"},
        "weitere_ersetzungen": {"type": "array", "description": "weitere Stellen derselben Entscheidung; setzt der Assistent von Hand um",
          "items": {"type": "object", "required": ["alt", "neu"],
                    "properties": {"alt": {"type": "string"}, "neu": {"type": "string"}, "datei": {"type": "string"}}}},
        "notiz": {"type": "string", "description": "Vermerk zur Umsetzung, z. B. in welcher anderen Datei sie erfolgte"}
      },
      "$comment": "Weitere Angaben des Assistenten sind erlaubt und bleiben erhalten; geprüft werden die festen Felder (YAWA #357)",
      "additionalProperties": true
    }
  },
  "properties": {
    "buch": {"type": "string"},
    "fassung": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "erstellt": {"type": "string", "format": "date"},
    "quelle": {"type": "array", "items": {"type": "string"}},
    "themen": {"type": "array", "description": "Entscheidungsthemen in der Reihenfolge der Abhängigkeit (#570)", "items": {"type": "object", "required": ["id", "titel"], "properties": {"id": {"type": "string"}, "titel": {"type": "string"}}, "additionalProperties": false}},
    "anleitung": {"type": "string"},
    "ohne_autor": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "autorenentscheidung": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/entry"}, {"required": ["frage"], "properties": {"art": {"enum": ["fakt", "kontinuitaet", "ton", "aufbau", "buchweit"]}}}]}},
    "ausgelassen": {"type": "array", "items": {"type": "object", "required": ["befund", "grund"], "properties": {"befund": {"type": "string"}, "grund": {"type": "string"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
