{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ploeffler/GhostWriter/schemas/approvals.schema.json",
  "title": "Freigabe-Protokoll (approvals.yml)",
  "description": "Jede erteilte oder zurückgenommene Freigabe als eigener Eintrag; Einträge werden nur angehängt, nie geändert oder gelöscht.",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "historical_references": {
      "description": "Dokumentierte historische Einträge mit nicht mehr vorhandenen Zielen; keine neuen Freigaben.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entry", "kind", "id", "reason"],
        "properties": {
          "entry": {"type": "integer", "minimum": 1},
          "kind": {"enum": ["writing", "section", "chapter", "matter", "image"]},
          "id": {"type": "string", "pattern": "^(sec|ch|mat|img)-[a-z0-9][a-z0-9-]*$"},
          "reason": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "additionalProperties": false
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id", "action", "at", "by", "commit"],
        "properties": {
          "kind": {"enum": ["writing", "section", "chapter", "matter", "image"]},
          "id": {"type": "string", "pattern": "^(sec|ch|mat|img)-[a-z0-9][a-z0-9-]*$"},
          "action": {"enum": ["granted", "revoked"]},
          "at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:[0-9]{2})$"},
          "by": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 des freigegebenen Manuskripttexts; bei section-Freigaben verpflichtend."},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
