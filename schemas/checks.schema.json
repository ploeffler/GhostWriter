{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ploeffler/GhostWriter/schemas/checks.schema.json",
  "title": "Prüfprotokoll eines Buchs (editorial/checks.yml, #331): gelaufene Prüfungen; ein Eintrag ist keine Freigabe",
  "type": "object",
  "required": ["checks"],
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "scope", "date", "result"],
        "properties": {
          "id": {"type": "string", "pattern": "^pr-[0-9]{3,}$"},
          "kind": {
            "type": "string",
            "pattern": "^(structure|language|proofreading|story_memory|quality_correction|analysis:[a-z_]+)$",
            "description": "structure: Strukturlektorat, language: Sprachlektorat, proofreading: Schlusskorrektur, story_memory: Buchgedächtnis, quality_correction: Qualitätskorrektur, analysis:<art>: Hintergrundanalyse"
          },
          "scope": {
            "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1},
            "description": "book, Kapitel-, Abschnitts- oder Teil-IDs"
          },
          "date": {"type": "string", "format": "date"},
          "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "Uhrzeit des Laufs (HH:MM, #340), optional"},
          "result": {"enum": ["passed", "passed_with_notes", "failed", "incomplete", "unknown"], "description": "unknown: nachgetragen, Ergebnis geht aus dem Bericht nicht hervor (#340)"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$", "description": "geprüfte Fassung (Commit)"},
          "digests": {
            "type": "object",
            "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{16}$"},
            "description": "Fingerabdruck des Manuskripts je geprüftem Abschnitt; Grundlage für „seit Prüfung geändert“"
          },
          "report": {"type": "string", "description": "Pfad des Berichts im Buch"},
          "run": {"type": "string", "description": "ID des Analyselaufs (bei analysis:<art>)"},
          "note": {"type": "string"},
          "notes": {"type": "integer", "minimum": 0, "description": "Zahl der offenen Hinweise im Bericht (#362), optional"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
