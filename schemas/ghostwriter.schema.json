{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ploeffler/GhostWriter/schemas/ghostwriter.schema.json",
  "title": "GhostWriter-Projektdatei (ghostwriter.yml)",
  "type": "object",
  "required": ["project", "ai_settings", "ai_providers", "workflow", "structure"],
  "properties": {
    "data_version": {"type": "integer", "minimum": 0, "description": "Datenstruktur-Version des Buchs; setzt scripts/migrate_project.py (#59), fehlt = 0"},
    "interface": {
      "type": "object",
      "description": "Bediensprache unabhängig vom Manuskript (#74); optional, sonst Assistenten-Profil bzw. Deutsch",
      "properties": {"language": {"type": "string", "pattern": "^(de|en)(-[A-Za-z]{2,8})?$"}},
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["title", "title_short", "working_title", "subtitle", "author", "language",
                   "description_short", "description", "target_audience", "book_type", "status", "current_edition"],
      "properties": {
        "title": {"type": "string"},
        "title_short": {"type": "string", "maxLength": 60},
        "working_title": {"type": "string"},
        "subtitle": {"type": "string"},
        "author": {"type": "string"},
        "language": {"type": "string", "minLength": 2},
        "translations_planned": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"}, "uniqueItems": true, "description": "geplante Übersetzungen als Sprachcodes; nur Angabe (#75)"},
        "description_short": {"type": "string"},
        "description": {"type": "string"},
        "target_audience": {"type": "string"},
        "book_type": {"type": "string"},
        "status": {"type": "string", "minLength": 1},
        "current_edition": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "ai_settings": {
      "type": "object",
      "required": ["hallucination_policy", "source_policy", "uncertainty_policy", "creativity", "web_research"],
      "properties": {
        "hallucination_policy": {"type": "string"},
        "source_policy": {"type": "string"},
        "uncertainty_policy": {"type": "string"},
        "creativity": {"type": "string"},
        "web_research": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ai_providers": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "rules": {"type": "object"},
        "available": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "services": {"type": "object", "additionalProperties": {"type": "object", "properties": {"access": {"enum": ["app", "api", "local", "cli", "web", "github"]}, "model": {"type": "string"}, "github_connected": {"type": "boolean"}, "plan": {"type": "string"}, "monthly_cost": {"type": ["number", "null"], "minimum": 0}, "note": {"type": "string"}, "api_key_secret": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "description": "Name des GitHub-Secrets mit dem API-Schlüssel; der Schlüssel selbst steht nie im Repository"}}, "additionalProperties": false}},
        "queue_processing": {"type": "object", "properties": {"agent": {"type": "string"}, "model": {"type": "string"}}}
      },
      "additionalProperties": {
        "type": "object",
        "required": ["provider", "model"],
        "properties": {
          "provider": {"type": "string"},
          "model": {"type": "string"},
          "search_tools": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "workflow": {
      "type": "object",
      "required": ["current_phase", "current_chapter_id", "current_section_id"],
      "properties": {
        "current_phase": {"type": "string", "minLength": 1},
        "current_chapter_id": {"type": ["string", "null"], "pattern": "^ch-[a-z0-9][a-z0-9-]*$"},
        "current_section_id": {"type": ["string", "null"], "pattern": "^sec-[a-z0-9][a-z0-9-]*$"},
        "require_section_writing_approval": {"type": "boolean"},
        "require_section_approval": {"type": "boolean"},
        "require_chapter_approval": {"type": "boolean"},
        "fact_checking_default": {"enum": ["disabled", "optional", "requested"]}
      },
      "additionalProperties": false
    },
    "updates": {
      "type": "object",
      "description": "Automatische GhostWriter-Updates (docs/UPDATES.md); fehlt der Block, gilt auto: true",
      "properties": {"auto": {"type": "boolean"}},
      "additionalProperties": false
    },
    "changes": {
      "type": "object",
      "description": "Übernehmen gespeicherter Änderungen (START.md, „Schreiben ins Repository“); fehlt der Block, gilt auto_merge: false",
      "properties": {"auto_merge": {"type": "boolean"}},
      "additionalProperties": false
    },
    "ai_disclosure": {
      "type": "object",
      "description": "KI-Angabe im Buch (#78): ob und wie angegeben wird, wie bei diesem Buch KI genutzt wurde; fehlt = keine Angabe",
      "properties": {
        "mode": {"enum": ["none", "short", "detailed", "custom"]},
        "placement": {"enum": ["imprint", "foreword", "afterword", "page"]},
        "name_services": {"type": "boolean"},
        "text": {"type": "string", "description": "vom Autor bestätigter Wortlaut; nur dieser kommt ins Buch"}
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "description": "Angaben im Impressum (#68): Verlag, ISBN je Ausgabe, Rechtehinweis; fehlt = keine",
      "properties": {
        "publisher": {"type": "string", "description": "Verlag; „Selbstverlag“ bei eigener Veröffentlichung"},
        "isbn_print": {"type": "string", "pattern": "^[0-9Xx -]{10,17}$"},
        "isbn_ebook": {"type": "string", "pattern": "^[0-9Xx -]{10,17}$"},
        "rights": {"type": "string", "description": "Rechtehinweis, z. B. „Alle Rechte vorbehalten.“"}
      },
      "additionalProperties": false
    },
    "print": {
      "type": "object",
      "description": "Druck (#68): Profil des Anbieters, Papier, Rückenbreite, Beschnitt, Schnittmarken; fehlt = kein Umschlag",
      "properties": {
        "profile": {"enum": ["kdp", "bod", "custom"]},
        "paper": {"enum": ["white", "cream", "premium_color"]},
        "spine_mm": {"type": "number", "minimum": 0, "maximum": 100},
        "paper_mm_per_page": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "bleed_mm": {"type": "number", "minimum": 0, "maximum": 20},
        "crop_marks": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "cover": {
      "type": "object",
      "description": "Umschlag (#68): Vorlage, Farben, Bilder, Preis; Texte der Rückseite in cover/rueckseite.md",
      "properties": {
        "template": {"enum": ["classic", "modern", "plain"]},
        "background": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "text_color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "image": {"type": "string", "pattern": "^cover/[^/]+\\.(jpe?g|png)$"},
        "author_image": {"type": "string", "pattern": "^cover/[^/]+\\.(jpe?g|png)$"},
        "price": {"type": "string"},
        "spine_direction": {"enum": ["down", "up"]}
      },
      "additionalProperties": false
    },
    "typesetting": {
      "type": "object",
      "description": "Buchsatz für die Auflagen; fehlt der Block, gelten die Vorgaben aus docs/DATA-MODEL.md",
      "properties": {
        "page_size": {"enum": ["a5", "12x19", "13.5x21.5", "a4"]},
        "font": {"enum": ["serif", "sans", "pagella", "termes", "bonum", "schola", "heros", "adventor"]},
        "font_size": {"enum": [10, 10.5, 11, 11.5, 12]},
        "title_page": {"type": "boolean"},
        "imprint": {"type": "boolean"},
        "toc": {"type": "boolean"},
        "toc_depth": {"enum": [1, 2]},
        "heading_font": {"enum": ["same", "serif", "sans"]},
        "margins": {"enum": ["standard", "classic", "modern"]},
        "line_spacing": {"enum": [1.0, 1.1, 1.2, 1.3, 1.5]},
        "paragraph": {"enum": ["indent", "spacing"]},
        "hyphenation": {"type": "boolean"},
        "chapter_start": {"enum": ["any", "right"]},
        "running_heads": {"enum": ["sections", "chapter", "book", "none"]},
        "page_numbers": {"enum": ["header", "footer_center", "footer_outer"]},
        "initials": {"type": "boolean"},
        "glossary_marks": {"enum": ["arrow", "italic", "none"]},
        "formats": {"type": "array", "items": {"enum": ["pdf", "pdf_print", "cover", "docx", "epub"]}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "description": "Analysen im Hintergrund (#123, scripts/analyze.py, Action „Analyse im Hintergrund“); fehlt = Vorgaben",
      "properties": {
        "provider": {"enum": ["anthropic", "openai"], "description": "Anbieter der API-Aufrufe; sonst der erste mit hinterlegtem Schlüssel"},
        "model": {"type": "string", "description": "Modell je Kapitel (günstig)"},
        "merge_model": {"type": "string", "description": "Modell fürs Zusammenführen (stärker)"},
        "price_input_per_mtok": {"type": ["number", "null"], "minimum": 0, "description": "Preis je 1 Mio. Eingabe-Tokens in Projektwährung"},
        "price_output_per_mtok": {"type": ["number", "null"], "minimum": 0, "description": "Preis je 1 Mio. Ausgabe-Tokens in Projektwährung"},
        "parallel": {"type": "integer", "minimum": 1, "maximum": 16}
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "description": "Stilprofil des Buchs (#124), übernommen aus der Analyse im Hintergrund (Art style) bzw. von Hand; Vorgabe fürs Ghostwriting",
      "properties": {
        "perspective": {"type": "string", "description": "Erzählperspektive, z. B. ich, er/sie, auktorial"},
        "tense": {"type": "string", "description": "Zeitform, z. B. Präteritum, Präsens"},
        "address": {"type": "string", "description": "Anrede des Lesers: du, Sie, ihr, keine"},
        "register": {"type": "string", "description": "Sprachebene: umgangssprachlich, neutral, gehoben, fachlich"},
        "tone": {"type": "array", "items": {"type": "string"}, "description": "Ton in wenigen Wörtern"},
        "features": {"type": "array", "items": {"type": "string"}, "description": "auffällige Stilmittel"},
        "sentence_length_avg": {"type": ["number", "null"], "minimum": 0, "description": "Wörter je Satz im Mittel (ohne KI gezählt)"},
        "dialogue_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Anteil wörtlicher Rede an allen Wörtern (ohne KI gezählt)"},
        "source": {"type": "string", "description": "Herkunft, z. B. analysis/style/run-001"}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "description": "Grenzen für die Automatik (#62): unter pause_below_percent pausiert, unter warn_below_percent Vorwarnung; fehlt = keine Grenzen",
      "properties": {
        "ai_budget_monthly": {"type": ["number", "null"], "minimum": 0, "description": "KI-Budget je Monat in Projektwährung; leer = kein eigenes Budget"},
        "actions_minutes_monthly": {"type": ["integer", "null"], "minimum": 0, "description": "Actions-Minuten je Monat (z. B. 2000 bei privaten Repositorys im Free-Plan); leer = nicht prüfen, in privaten Repositorys 2000"},
        "actions_minutes_warn_below": {"type": ["integer", "null"], "minimum": 0, "description": "Vorwarnung, wenn weniger Actions-Minuten übrig sind (#277); fehlt = 300, null = keine"},
        "actions_minutes_pause_below": {"type": ["integer", "null"], "minimum": 0, "description": "Automatik pausiert, wenn weniger Actions-Minuten übrig sind (#277); fehlt = 100, null = keine"},
        "pause_below_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "warn_below_percent": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "description": "Illustrationen (#54): Bildstil des Buchs und Bildnachweis; fehlt = Vorgaben",
      "properties": {
        "style": {"type": "string", "description": "Stil für alle Bild-Aufträge, z. B. „Aquarell, weiche Farben, kindgerecht“"},
        "credit_in_imprint": {"type": "boolean", "description": "KI-erzeugte Bilder im Impressum nennen; fehlt = true"},
        "max_px": {"type": "integer", "minimum": 600, "maximum": 6000, "description": "längste Kante beim Ablegen; fehlt = 3000"}
      },
      "additionalProperties": false
    },
    "characters": {
      "type": "array",
      "description": "Figuren des Buchs (#53) in Reihenfolge; fehlt = keine",
      "items": {
        "type": "object",
        "required": ["id", "name", "path"],
        "properties": {
          "id": {"type": "string", "pattern": "^char-[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^characters/[^/]+\\.md$"}
        },
        "additionalProperties": false
      }
    },
    "structure": {
      "type": "object",
      "required": ["chapters"],
      "properties": {
        "front_matter": {
          "type": "array",
          "description": "Vorspann vor Kapitel 1 (#57, #58): Widmung, Vorwort, Prolog; fehlt = keiner",
          "items": {
            "type": "object",
            "required": ["id", "kind", "title", "path"],
            "properties": {
              "id": {"type": "string", "pattern": "^mat-[a-z0-9][a-z0-9-]*$"},
              "kind": {"enum": ["dedication", "foreword", "prologue"]},
              "title": {"type": "string", "minLength": 1},
              "path": {"type": "string", "pattern": "^matter/[^/]+\\.md$"}
            },
            "additionalProperties": false
          }
        },
        "back_matter": {
          "type": "array",
          "description": "Nachspann nach dem letzten Kapitel (#57, #58): Epilog, Nachwort, Glossar, Danksagung; fehlt = keiner",
          "items": {
            "type": "object",
            "required": ["id", "kind", "title", "path"],
            "properties": {
              "id": {"type": "string", "pattern": "^mat-[a-z0-9][a-z0-9-]*$"},
              "kind": {"enum": ["epilogue", "afterword", "glossary", "acknowledgments"]},
              "title": {"type": "string", "minLength": 1},
              "path": {"type": "string", "pattern": "^matter/[^/]+\\.md$"}
            },
            "additionalProperties": false
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "path", "status", "sections"],
            "properties": {
              "id": {"type": "string", "pattern": "^ch-[a-z0-9][a-z0-9-]*$"},
              "title": {"type": "string", "minLength": 1},
              "path": {"type": "string", "pattern": "^chapters/[^/]+$"},
              "status": {"enum": ["planned", "in_progress", "ready_for_assembly", "assembly", "review", "ready_for_approval", "approved"]},
              "sections": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "title", "path"],
                  "properties": {
                    "id": {"type": "string", "pattern": "^sec-[a-z0-9][a-z0-9-]*$"},
                    "title": {"type": "string", "minLength": 1},
                    "path": {"type": "string", "pattern": "^chapters/[^/]+/sections/[^/]+\\.md$"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
