{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ploeffler/GhostWriter/schemas/ghostwriter.schema.json",
  "title": "GhostWriter-Projektdatei (ghostwriter.yml)",
  "type": "object",
  "required": ["project", "ai_settings", "ai_providers", "workflow", "structure"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["title", "title_short", "working_title", "subtitle", "author", "language",
                   "description_short", "description", "target_audience", "book_type", "status", "current_edition"],
      "properties": {
        "title": {"type": "string"},
        "title_short": {"type": "string", "maxLength": 60},
        "working_title": {"type": "string"},
        "subtitle": {"type": "string"},
        "author": {"type": "string"},
        "language": {"type": "string", "minLength": 2},
        "description_short": {"type": "string"},
        "description": {"type": "string"},
        "target_audience": {"type": "string"},
        "book_type": {"type": "string"},
        "status": {"type": "string", "minLength": 1},
        "current_edition": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "ai_settings": {
      "type": "object",
      "required": ["hallucination_policy", "source_policy", "uncertainty_policy", "creativity", "web_research"],
      "properties": {
        "hallucination_policy": {"type": "string"},
        "source_policy": {"type": "string"},
        "uncertainty_policy": {"type": "string"},
        "creativity": {"type": "string"},
        "web_research": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ai_providers": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "rules": {"type": "object"},
        "queue_processing": {"type": "object", "properties": {"agent": {"type": "string"}, "model": {"type": "string"}}}
      },
      "additionalProperties": {
        "type": "object",
        "required": ["provider", "model"],
        "properties": {
          "provider": {"type": "string"},
          "model": {"type": "string"},
          "search_tools": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "workflow": {
      "type": "object",
      "required": ["current_phase", "current_chapter_id", "current_section_id"],
      "properties": {
        "current_phase": {"type": "string", "minLength": 1},
        "current_chapter_id": {"type": ["string", "null"], "pattern": "^ch-[a-z0-9][a-z0-9-]*$"},
        "current_section_id": {"type": ["string", "null"], "pattern": "^sec-[a-z0-9][a-z0-9-]*$"},
        "require_section_writing_approval": {"type": "boolean"},
        "require_section_approval": {"type": "boolean"},
        "require_chapter_approval": {"type": "boolean"},
        "fact_checking_default": {"enum": ["disabled", "optional", "requested"]}
      },
      "additionalProperties": false
    },
    "structure": {
      "type": "object",
      "required": ["chapters"],
      "properties": {
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "path", "status", "sections"],
            "properties": {
              "id": {"type": "string", "pattern": "^ch-[a-z0-9][a-z0-9-]*$"},
              "title": {"type": "string", "minLength": 1},
              "path": {"type": "string", "pattern": "^chapters/[^/]+$"},
              "status": {"enum": ["planned", "in_progress", "ready_for_assembly", "assembly", "review", "ready_for_approval", "approved"]},
              "sections": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "title", "path"],
                  "properties": {
                    "id": {"type": "string", "pattern": "^sec-[a-z0-9][a-z0-9-]*$"},
                    "title": {"type": "string", "minLength": 1},
                    "path": {"type": "string", "pattern": "^chapters/[^/]+/sections/[^/]+\\.md$"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
