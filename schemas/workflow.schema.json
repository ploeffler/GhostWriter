{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostwriter.example/schemas/workflow.schema.json",
  "title": "GhostWriter Workflow Configuration",
  "type": "object",
  "required": [
    "version",
    "id",
    "authority",
    "global_ai_policy",
    "entities",
    "section_workflow",
    "chapter_workflow",
    "github_automation",
    "cost_tracking"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "authority": {
      "type": "object",
      "required": [
        "source_of_truth",
        "project_metadata",
        "manuscript_and_history",
        "approvals_require_explicit_user_confirmation",
        "automation_must_not_infer_approval"
      ],
      "properties": {
        "source_of_truth": {
          "const": "workflow.yml"
        },
        "project_metadata": {
          "type": "string"
        },
        "manuscript_and_history": {
          "type": "string"
        },
        "approvals_require_explicit_user_confirmation": {
          "const": true
        },
        "automation_must_not_infer_approval": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "global_ai_policy": {
      "type": "object",
      "required": [
        "hallucination_policy",
        "source_policy",
        "uncertainty_policy",
        "creativity",
        "web_research",
        "override_policy"
      ],
      "properties": {
        "hallucination_policy": {
          "const": "strict"
        },
        "source_policy": {
          "const": "required"
        },
        "uncertainty_policy": {
          "const": "explicit"
        },
        "creativity": {
          "const": "balanced"
        },
        "web_research": {
          "const": "research"
        },
        "override_policy": {
          "const": "stricter_freely_looser_with_confirmation"
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "object",
      "required": [
        "chapter",
        "section"
      ],
      "properties": {
        "chapter": {
          "type": "object",
          "required": [
            "id_pattern",
            "stable_id",
            "visible_number",
            "min_sections",
            "statuses"
          ],
          "properties": {
            "id_pattern": {
              "type": "string"
            },
            "stable_id": {
              "const": true
            },
            "visible_number": {
              "const": "derived_from_order"
            },
            "min_sections": {
              "type": "integer",
              "minimum": 1
            },
            "statuses": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": true
        },
        "section": {
          "type": "object",
          "required": [
            "id_pattern",
            "stable_id",
            "visible_number",
            "statuses"
          ],
          "properties": {
            "id_pattern": {
              "type": "string"
            },
            "stable_id": {
              "const": true
            },
            "visible_number": {
              "const": "derived_from_order"
            },
            "statuses": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "fact_check": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "object"
    },
    "section_workflow": {
      "type": "object",
      "required": [
        "initial_status",
        "transitions",
        "invariants"
      ],
      "properties": {
        "initial_status": {
          "enum": ["planned"]
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "trigger"
            ],
            "properties": {
              "from": {
                "enum": ["planned", "research", "brainstorming", "ready_to_write", "writing", "revision", "fact_check", "ready_for_approval", "approved"]
              },
              "to": {
                "enum": ["planned", "research", "brainstorming", "ready_to_write", "writing", "revision", "fact_check", "ready_for_approval", "approved"]
              },
              "trigger": {
                "type": "string"
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "optional": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "chapter_workflow": {
      "type": "object",
      "required": [
        "initial_status",
        "transitions",
        "invariants"
      ],
      "properties": {
        "initial_status": {
          "enum": ["planned"]
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "trigger"
            ],
            "properties": {
              "from": {
                "enum": ["planned", "in_progress", "ready_for_assembly", "assembly", "review", "ready_for_approval", "approved"]
              },
              "to": {
                "enum": ["planned", "in_progress", "ready_for_assembly", "assembly", "review", "ready_for_approval", "approved"]
              },
              "trigger": {
                "type": "string"
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "structure_changes": {
      "type": "object"
    },
    "github_automation": {
      "type": "object",
      "required": [
        "issue_per_unit_of_work",
        "milestone_per_chapter_or_project_phase",
        "issue_must_include_when_created",
        "task_types",
        "approval_policy"
      ],
      "properties": {
        "issue_per_unit_of_work": {
          "type": "boolean"
        },
        "issue_creation": {"type": "string", "const": "optional_or_explicitly_requested"},
        "milestone_creation": {"type": "string"},
        "milestone_per_chapter_or_project_phase": {
          "type": "boolean"
        },
        "issue_must_include_when_created": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval_policy": {
          "type": "object",
          "required": [
            "github_issue_closure_is_not_user_approval",
            "milestone_completion_is_not_user_approval",
            "only_explicit_chat_confirmation_counts"
          ],
          "properties": {
            "github_issue_closure_is_not_user_approval": {
              "const": true
            },
            "milestone_completion_is_not_user_approval": {
              "const": true
            },
            "only_explicit_chat_confirmation_counts": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "audit": {
      "type": "object"
    },
    "product_roadmap": {
      "type": "object",
      "required": [
        "current_target",
        "v0_5",
        "v1_0",
        "delivery_policy"
      ],
      "properties": {
        "current_target": {
          "type": "string"
        },
        "v0_5": {
          "type": "object",
          "required": [
            "purpose",
            "scope"
          ],
          "properties": {
            "purpose": {
              "const": "usable_basics"
            },
            "scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "v1_0": {
          "type": "object",
          "required": [
            "purpose",
            "scope"
          ],
          "properties": {
            "purpose": {
              "const": "complete_book_workflow_without_ai_provider_apis"
            },
            "scope": {
              "type": "string"
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deferred_until_after_v1_0": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ai_execution": {
              "const": "chat_or_copy_order_and_review_returned_results"
            },
            "acceptance_requires_provider_credentials": {
              "const": false
            },
            "approved_decisions": {"const": "docs/ENTSCHEIDUNGEN-v1.0.md"},
            "implementation_orders": {"const": "docs/AUFTRAEGE-v1.0.md"},
            "supported_clients": {
              "const": ["chatgpt", "codex", "claude", "openwebui"]
            },
            "display_changes_require_all_client_checks": {"const": true}
          },
          "additionalProperties": false
        },
        "delivery_policy": {
          "type": "object",
          "required": [
            "incremental_delivery",
            "v0_5_must_be_useful_without_v1_0_features",
            "do_not_block_basic_book_work_on_advanced_automation"
          ],
          "properties": {
            "incremental_delivery": {
              "const": true
            },
            "v0_5_must_be_useful_without_v1_0_features": {
              "const": true
            },
            "do_not_block_basic_book_work_on_advanced_automation": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "v0_5_steps": {
          "type": "object",
          "required": [
            "operating_path",
            "later_path_considered",
            "tracking",
            "steps"
          ],
          "properties": {
            "operating_path": {
              "const": "chat_with_github_connection"
            },
            "later_path_considered": {
              "const": "own_api_and_mcp"
            },
            "tracking": {
              "const": "github_milestones_and_issues"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "version",
                  "goal"
                ],
                "properties": {
                  "version": {
                    "type": "string",
                    "pattern": "^v[0-9]+\\.[0-9]+$"
                  },
                  "goal": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "book_releases": {
      "type": "object",
      "required": [
        "purpose",
        "platform",
        "tag_pattern",
        "immutable_snapshot",
        "release_must_reference_commit",
        "release_notes_required",
        "approval",
        "distinction",
        "name_pattern",
        "edition_numbering",
        "new_edition_trigger",
        "corrections_between_editions"
      ],
      "properties": {
        "purpose": {
          "const": "versioned_book_editions"
        },
        "platform": {
          "const": "github_releases"
        },
        "name_pattern": {
          "type": "string"
        },
        "tag_pattern": {
          "type": "string"
        },
        "edition_numbering": {
          "const": "integer_starting_at_1"
        },
        "new_edition_trigger": {
          "const": "explicit_user_request"
        },
        "corrections_between_editions": {
          "const": "collected_in_repository_until_next_edition"
        },
        "immutable_snapshot": {
          "const": true
        },
        "release_must_reference_commit": {
          "const": true
        },
        "release_notes_required": {
          "const": true
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval": {
          "type": "object",
          "required": [
            "explicit_user_approval_required",
            "only_approved_manuscript_content_may_be_released"
          ],
          "properties": {
            "explicit_user_approval_required": {
              "const": true
            },
            "only_approved_manuscript_content_may_be_released": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "distinction": {
          "type": "object",
          "required": [
            "product_milestones_are_not_book_releases",
            "github_software_tags_are_not_book_edition_tags"
          ],
          "properties": {
            "product_milestones_are_not_book_releases": {
              "const": true
            },
            "github_software_tags_are_not_book_edition_tags": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cost_tracking": {
      "type": "object",
      "required": [
        "enabled",
        "purpose",
        "project_currency",
        "attribution",
        "activity_record",
        "aggregation",
        "v0_5",
        "v1_0",
        "invariants",
        "storage",
        "scope"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "purpose": {
          "const": "transparent_ai_activity_cost_accounting"
        },
        "project_currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "attribution": {
          "type": "object",
          "required": [
            "primary_unit",
            "section_id_required",
            "chapter_total",
            "project_total",
            "prevent_double_counting"
          ],
          "properties": {
            "primary_unit": {
              "const": "section"
            },
            "section_id_required": {
              "const": "for_section_activity_only"
            },
            "project_level_activity_may_omit_section_id": {
              "const": true
            },
            "chapter_total": {
              "const": "sum_of_assigned_section_costs"
            },
            "project_total": {
              "const": "sum_of_all_chapter_totals_and_project_level_costs"
            },
            "allow_project_level_costs": {
              "type": "boolean"
            },
            "prevent_double_counting": {
              "const": true
            }
          },
          "additionalProperties": true
        },
        "activity_record": {
          "type": "object",
          "required": [
            "immutable",
            "one_record_per_ai_activity",
            "required_fields",
            "cost_status_values"
          ],
          "properties": {
            "immutable": {
              "const": true
            },
            "one_record_per_ai_activity": {
              "const": true
            },
            "required_fields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "optional_usage_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pricing_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cost_status_values": {
              "type": "array",
              "items": {
                "enum": [
                  "actual",
                  "estimated",
                  "manually_entered",
                  "unavailable"
                ]
              },
              "minItems": 4
            },
            "preserve_original_currency_and_amount": {
              "type": "boolean"
            },
            "conversion": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "aggregation": {
          "type": "object",
          "required": [
            "section_subtotal",
            "chapter_subtotal",
            "project_total",
            "show_actual_and_estimated_separately"
          ],
          "properties": {
            "section_subtotal": {
              "const": "sum_of_activity_records_for_section"
            },
            "chapter_subtotal": {
              "const": "sum_of_section_subtotals"
            },
            "project_total": {
              "const": "sum_of_chapter_subtotals_and_project_level_costs"
            },
            "show_currency": {
              "type": "boolean"
            },
            "show_actual_and_estimated_separately": {
              "const": true
            },
            "show_usage_and_cost_breakdown": {
              "type": "boolean"
            },
            "refresh_after_each_record": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "v0_5": {
          "type": "object",
          "required": [
            "scope",
            "includes"
          ],
          "properties": {
            "scope": {
              "const": "basic_cost_tracking"
            },
            "includes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cost_display_optional": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "v1_0": {
          "type": "object",
          "required": [
            "scope",
            "includes"
          ],
          "properties": {
            "scope": {
              "const": "cost_transparency_without_provider_connections"
            },
            "includes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "currency_is_configurable": {
          "type": "boolean"
        },
        "storage": {
          "type": "object",
          "required": [
            "format",
            "section_ledger_path",
            "project_ledger_path",
            "one_file_per_section",
            "append_only"
          ],
          "properties": {
            "format": {
              "const": "yaml"
            },
            "section_ledger_path": {
              "type": "string"
            },
            "project_ledger_path": {
              "type": "string"
            },
            "one_file_per_section": {
              "const": true
            },
            "append_only": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "scope": {
          "type": "object",
          "required": [
            "records",
            "excludes"
          ],
          "properties": {
            "records": {
              "type": "array",
              "items": {"enum": ["backend_ai_api_calls", "action_ai_api_calls"]},
              "minItems": 2,
              "uniqueItems": true
            },
            "excludes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "run_history_separate": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "provider_selection": {
      "type": "object",
      "required": [
        "config_source",
        "catalog",
        "roles",
        "record_provider_and_model_per_run"
      ],
      "properties": {
        "purpose": {
          "type": "string"
        },
        "config_source": {
          "type": "string"
        },
        "catalog": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "research",
              "brainstorming",
              "writing",
              "revision",
              "fact_check",
              "queue_processing"
            ]
          }
        },
        "fallback_role": {
          "type": "string"
        },
        "special_provider_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "queue_processing_uses": {
          "type": "string"
        },
        "record_provider_and_model_per_run": {
          "const": true
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "session_backup": {
      "type": "object",
      "required": [
        "commands",
        "storage",
        "branch",
        "commit_policy",
        "pull_request_policy",
        "auto_merge_on_save",
        "auto_save_trigger",
        "auto_save_requires",
        "accept_steps",
        "content_approval_granted",
        "manuscript_changes_allowed",
        "instructions"
      ],
      "properties": {
        "commands": {
          "type": "object",
          "required": [
            "save",
            "load",
            "accept"
          ],
          "properties": {
            "save": {
              "const": [
                "Session sichern",
                "Chat sichern",
                "Chat speichern"
              ]
            },
            "load": {
              "const": [
                "Session laden"
              ]
            },
            "accept": {
              "const": [
                "Session übernehmen"
              ]
            }
          },
          "additionalProperties": false
        },
        "storage": {
          "const": "conversations/<session-id>/"
        },
        "branch": {
          "const": "ghostwriter/chat/<session-id>"
        },
        "commit_policy": {
          "const": "one_per_changed_coherent_topic"
        },
        "pull_request_policy": {
          "const": "one_per_session"
        },
        "auto_merge_on_save": {
          "const": false
        },
        "auto_save_trigger": {
          "const": "section_dialogue_completed"
        },
        "auto_save_requires": {
          "const": ["no_awaiting_reply", "all_discussed_items_answered_decided_or_explicitly_deferred", "message_evidence"]
        },
        "accept_steps": {
          "const": [
            "validate",
            "diagnose_failure",
            "attempt_safe_technical_repair",
            "revalidate",
            "merge"
          ]
        },
        "content_approval_granted": {
          "const": false
        },
        "manuscript_changes_allowed": {
          "const": false
        },
        "instructions": {
          "const": "docs/SESSION-SICHERUNG.md"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
