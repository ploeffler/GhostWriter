{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostwriter.example/schemas/workflow.schema.json",
  "title": "GhostWriter Workflow Configuration",
  "type": "object",
  "required": [
    "version",
    "id",
    "authority",
    "global_ai_policy",
    "entities",
    "section_workflow",
    "chapter_workflow",
    "github_automation"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "authority": {
      "type": "object",
      "required": [
        "source_of_truth",
        "project_metadata",
        "manuscript_and_history",
        "approvals_require_explicit_user_confirmation",
        "automation_must_not_infer_approval"
      ],
      "properties": {
        "source_of_truth": {
          "const": "workflow.yml"
        },
        "project_metadata": {
          "type": "string"
        },
        "manuscript_and_history": {
          "type": "string"
        },
        "approvals_require_explicit_user_confirmation": {
          "const": true
        },
        "automation_must_not_infer_approval": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "global_ai_policy": {
      "type": "object",
      "required": [
        "hallucination_policy",
        "source_policy",
        "uncertainty_policy",
        "creativity",
        "web_research",
        "override_policy"
      ],
      "properties": {
        "hallucination_policy": {
          "const": "strict"
        },
        "source_policy": {
          "const": "required"
        },
        "uncertainty_policy": {
          "const": "explicit"
        },
        "creativity": {
          "const": "balanced"
        },
        "web_research": {
          "const": "research"
        },
        "override_policy": {
          "const": "only_add_stricter_rules"
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "object",
      "required": [
        "chapter",
        "section"
      ],
      "properties": {
        "chapter": {
          "type": "object",
          "required": [
            "id_pattern",
            "stable_id",
            "visible_number",
            "min_sections",
            "statuses"
          ],
          "properties": {
            "id_pattern": {
              "type": "string"
            },
            "stable_id": {
              "const": true
            },
            "visible_number": {
              "const": "derived_from_order"
            },
            "min_sections": {
              "type": "integer",
              "minimum": 1
            },
            "statuses": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          },
          "additionalProperties": true
        },
        "section": {
          "type": "object",
          "required": [
            "id_pattern",
            "stable_id",
            "visible_number",
            "statuses"
          ],
          "properties": {
            "id_pattern": {
              "type": "string"
            },
            "stable_id": {
              "const": true
            },
            "visible_number": {
              "const": "derived_from_order"
            },
            "statuses": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "fact_check": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "object"
    },
    "section_workflow": {
      "type": "object",
      "required": [
        "initial_status",
        "transitions",
        "invariants"
      ],
      "properties": {
        "initial_status": {
          "type": "string"
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "trigger"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "optional": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "chapter_workflow": {
      "type": "object",
      "required": [
        "initial_status",
        "transitions",
        "invariants"
      ],
      "properties": {
        "initial_status": {
          "type": "string"
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "trigger"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "structure_changes": {
      "type": "object"
    },
    "github_automation": {
      "type": "object",
      "required": [
        "issue_per_unit_of_work",
        "milestone_per_chapter_or_project_phase",
        "issue_must_include",
        "task_types",
        "approval_policy"
      ],
      "properties": {
        "issue_per_unit_of_work": {
          "type": "boolean"
        },
        "milestone_per_chapter_or_project_phase": {
          "type": "boolean"
        },
        "issue_must_include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "task_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval_policy": {
          "type": "object",
          "required": [
            "github_issue_closure_is_not_user_approval",
            "milestone_completion_is_not_user_approval",
            "only_explicit_chat_confirmation_counts"
          ],
          "properties": {
            "github_issue_closure_is_not_user_approval": {
              "const": true
            },
            "milestone_completion_is_not_user_approval": {
              "const": true
            },
            "only_explicit_chat_confirmation_counts": {
              "const": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "audit": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
